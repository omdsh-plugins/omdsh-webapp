{
  "name": "@omdsh-plugins/omdsh-webapp",
  "description": "The harness web UI as a native desktop application for macOS and Windows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-plugins/omdsh-webapp.git"
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "os": [
    "darwin",
    "win32"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "package:mac": "tsx scripts/package-macos-app.ts",
    "package:win": "tsx scripts/package-windows-app.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icon:render": "tsx scripts/render-icons.ts",
    "clean": "tsx scripts/clean.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
